{
  "realm": "creanova",
  "enabled": true,
  "displayName": "Creanova Local",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard Creanova user"
      },
      {
        "name": "admin",
        "description": "Creanova admin (credits + user ops)"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@creanova.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Creanova",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    },
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@creanova.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ],
  "clients": [
    {
      "clientId": "creanova-local",
      "name": "Creanova Local Gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "creanova-local-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "http://192.168.1.191:*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocol": "openid-connect"
    },
    {
      "clientId": "beszel",
      "name": "Creanova Beszel Monitor",
      "enabled": true,
      "publicClient": false,
      "secret": "beszel-local-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18090/api/oauth2-redirect",
        "http://localhost:18090/api/oauth2-redirect",
        "http://192.168.1.191:18090/api/oauth2-redirect"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "access.token.lifespan": "3600",
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    }
  ]
}
