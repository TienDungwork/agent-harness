# Copy to .env and replace secrets. Do not commit .env.

# ClickHouse admin (default user)
CLICKHOUSE_PASSWORD=change_me_ch_admin

# App users created by init/02_users.sh
CH_SYNC_PASSWORD=change_me_ch_sync
CH_AGENT_PASSWORD=change_me_ch_agent
CH_VMS_PASSWORD=change_me_ch_vms

# Postgres source (192.168.1.242:18644) — role vms_sync_ro, not superuser
PG_HOST=192.168.1.242
PG_PORT=18644
PG_USER=vms_sync_ro
PG_PASSWORD=change_me_pg_sync_ro

# Worker
POLL_SECONDS=60
BATCH_SIZE=20000
LAG_SECONDS=30
