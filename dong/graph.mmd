---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	guardrail_input(guardrail_input)
	guardrail_output(guardrail_output)
	recall(recall)
	rewrite(rewrite)
	classify(classify)
	respond_inline(respond_inline)
	orchestrator(orchestrator)
	orchestrator_collect(orchestrator_collect)
	retrieve_schema(retrieve_schema)
	generate_sql(generate_sql)
	validate_sql(validate_sql)
	repair_sql(repair_sql)
	execute_sql(execute_sql)
	render_chart(render_chart)
	respond(respond)
	retrieve_docs(retrieve_docs)
	answer_from_docs(answer_from_docs)
	__end__([<p>__end__</p>]):::last
	__start__ --> guardrail_input;
	answer_from_docs -.-> orchestrator_collect;
	answer_from_docs -.-> respond;
	classify -.-> orchestrator;
	classify -.-> respond_inline;
	execute_sql -.-> orchestrator_collect;
	execute_sql -.-> render_chart;
	execute_sql -.-> repair_sql;
	execute_sql -.-> respond;
	generate_sql --> validate_sql;
	guardrail_input --> recall;
	orchestrator -.-> respond;
	orchestrator -. &nbsp;out&nbsp; .-> respond_inline;
	orchestrator -. &nbsp;docs&nbsp; .-> retrieve_docs;
	orchestrator -. &nbsp;query_data&nbsp; .-> retrieve_schema;
	orchestrator_collect -.-> orchestrator;
	orchestrator_collect -.-> respond;
	recall --> rewrite;
	render_chart --> respond;
	repair_sql --> validate_sql;
	respond --> guardrail_output;
	respond_inline --> respond;
	retrieve_docs --> answer_from_docs;
	retrieve_schema --> generate_sql;
	rewrite --> classify;
	validate_sql -.-> execute_sql;
	validate_sql -.-> repair_sql;
	validate_sql -.-> respond;
	guardrail_output --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
