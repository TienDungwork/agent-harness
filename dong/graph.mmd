---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	rewrite(rewrite)
	classify(classify)
	retrieve_schema(retrieve_schema)
	plan_query(plan_query)
	validate(validate)
	execute(execute)
	render_chart(render_chart)
	respond(respond)
	retrieve_docs(retrieve_docs)
	answer_from_docs(answer_from_docs)
	out_of_scope(out_of_scope)
	__end__([<p>__end__</p>]):::last
	__start__ --> rewrite;
	rewrite --> classify;
	classify -.-> retrieve_schema;
	classify -.-> retrieve_docs;
	classify -.-> out_of_scope;
	retrieve_schema --> plan_query;
	plan_query --> validate;
	validate --> execute;
	execute -.-> render_chart;
	execute -.-> respond;
	render_chart --> respond;
	respond --> __end__;
	retrieve_docs --> answer_from_docs;
	answer_from_docs --> __end__;
	out_of_scope --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
