# Sao chép: cp .env.example .env
# Docker demo: docker compose up --build -d
# Langfuse: cd langfuse && docker compose up -d
#
# ── Production Docker Demo (self_hosted) ─────────────────────────────────────
# Khi chạy qua Docker (`docker compose up --build -d`), service ai_backend mặc định:
#   LLM_BACKEND=self_hosted
#   MODEL_BASE_URL=http://192.168.1.196:18083/v1
#   MODEL_NAME=qwen3-4b
#   MODEL_ENDPOINT=http://192.168.1.196:18083/v1/chat/completions
#
# Các biến BẮT BUỘC cần điền cho Live Demo / Production:
#   1. MODEL_API_KEY: API key của gateway LLM self_hosted (nếu gateway yêu cầu)
#   2. DB_HOST, DB_PORT, DB_USER, DB_PASSWORD: Thông tin kết nối Postgres VMS (read-only)
#   3. DB_NAME_ITS, DB_NAME_FENCE, DB_NAME_FACE, DB_NAME_FIRE, DB_NAME_ANOMALY
#   4. DB_ORGANIZATION_ID (mặc định 0)
#
# Để chạy OpenAI smoke test thay vì self_hosted:
#   Override trong .env: set `LLM_BACKEND=openai` và điền `LLM_API_KEY` hoặc `OPENAI_API_KEYS`.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# LLM_BACKEND=openai|self_hosted
# - Production Docker: mặc định self_hosted (qua compose defaults)
# - OpenAI smoke test: override LLM_BACKEND=openai bên dưới
LLM_BACKEND=openai
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_S=15
# OPENAI_API_KEYS: chuỗi key cách nhau dấu phẩy để xoay vòng (comma rotation; copy từ llm-engineer-demo/.env, do not commit secrets)
OPENAI_API_KEYS=
ANSWER_USE_LLM=true

# self_hosted: mặc định trỏ tới 192.168.1.196:18083 (khi LLM_BACKEND=self_hosted)
MODEL_BASE_URL=http://192.168.1.196:18083/v1
MODEL_NAME=qwen3-4b
MODEL_API_KEY=your_gateway_api_key
MODEL_ENDPOINT=http://192.168.1.196:18083/v1/chat/completions

# Demo self_hosted (có thể bỏ comment hoặc để Docker compose tự default):
# LLM_BACKEND=self_hosted

# ── Postgres VMS (READ-ONLY) ─────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_USER=agent_readonly
DB_PASSWORD=
DB_NAME_ITS=its
DB_NAME_FENCE=virtual_fence
DB_NAME_FACE=smart_face
DB_NAME_FIRE=firesmoke
DB_NAME_ANOMALY=anomaly
DB_ORGANIZATION_ID=0
DB_QUERY_TIMEOUT_S=5.0
DB_MAX_ROWS=200

# ── ClickHouse (READ-ONLY, tuỳ chọn) ─────────────────────────────────────────
CH_HOST=
CH_PORT=8123
CH_USER=
CH_PASSWORD=
CH_DATABASE=

# ── Guardrails ───────────────────────────────────────────────────────────────
GUARDRAILS_MIN_ANSWER_LEN=5
GUARDRAILS_MAX_ANSWER_LEN=2000

# ── Langfuse — cd langfuse && docker compose up -d | admin@agent-atin.local / Atin@123# ─
MONITORING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-0c271516-d371-4a03-9ea6-0a9c22f131c2
LANGFUSE_SECRET_KEY=sk-lf-cda213a6-b0a0-4e61-9df5-ca38c0d280c3
LANGFUSE_HOST=http://localhost:3000

# ── Memory (3 lớp) ───────────────────────────────────────────────────────────
# MEMORY_ENABLED=false → tắt cả short-term, long-term, TTL cache
MEMORY_ENABLED=true
# LangGraph checkpointer (thread_id=session_id, giữ messages giữa các lượt)
MEMORY_SHORT_TERM_ENABLED=true
# Recall + store_extract (facts theo user_id; tùy chọn QDRANT_URL)
MEMORY_LONG_TERM_ENABLED=true
# TTL response cache trước graph (alias CACHE_ENABLED)
CACHE_ENABLED=true

# Rewrite decompose (gom trong rewrite — câu ngắn hơn ngưỡng không gọi LLM)
AGENT_DECOMPOSE_MIN_CHARS=48
AGENT_MAX_SUB_QUESTIONS=4
CACHE_TTL_S=60
MEMORY_TTL_SECONDS=300

# ── v5 (QueryPlan + docs YAML) ───────────────────────────────────────────────
DOCS_ROOT=resource/docs/vms_yaml
# SQL_REPAIR_MAX: số lần replan khi validate/execute lỗi (mặc định 1).
SQL_REPAIR_MAX=1

# ── Docker Compose ports ─────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
