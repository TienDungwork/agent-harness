# Sao chép: cp .env.example .env
# Docker demo: docker compose up --build -d
# Langfuse: ./scripts/setup-langfuse.sh

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_BACKEND=openai
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
OPENAI_API_KEYS=
ANSWER_USE_LLM=true

# Ollama LAN 196 (LLM_BACKEND=self_hosted)
MODEL_BASE_URL=http://192.168.1.196:11434/v1
MODEL_NAME=qwen3-16k-nothink:latest
MODEL_API_KEY=ollama
MODEL_ENDPOINT=http://192.168.1.196:11434/v1/chat/completions

# Trong container Docker, Ollama trên máy host:
# LLM_BACKEND=self_hosted
# MODEL_BASE_URL=http://host.docker.internal:11434/v1

# ── Postgres VMS (READ-ONLY) ─────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_USER=agent_readonly
DB_PASSWORD=
DB_NAME_ITS=its
DB_NAME_FENCE=virtual_fence
DB_NAME_FACE=smart_face
DB_NAME_FIRE=firesmoke
DB_NAME_ANOMALY=anomaly
DB_ORGANIZATION_ID=0
DB_QUERY_TIMEOUT_S=5.0
DB_MAX_ROWS=200

# ── ClickHouse (READ-ONLY, tuỳ chọn) ─────────────────────────────────────────
CH_HOST=
CH_PORT=8123
CH_USER=
CH_PASSWORD=
CH_DATABASE=

# ── Guardrails ───────────────────────────────────────────────────────────────
GUARDRAILS_MIN_ANSWER_LEN=5
GUARDRAILS_MAX_ANSWER_LEN=2000

# ── Langfuse — ./scripts/setup-langfuse.sh | admin@agent-atin.local / Atin@123# ─
MONITORING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-0c271516-d371-4a03-9ea6-0a9c22f131c2
LANGFUSE_SECRET_KEY=sk-lf-cda213a6-b0a0-4e61-9df5-ca38c0d280c3
LANGFUSE_HOST=http://localhost:3000

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_S=60

# ── Docker Compose ports ─────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
