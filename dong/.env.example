# Sao chép: cp .env.example .env
# Docker demo: docker compose up --build -d
# Langfuse: cd langfuse && docker compose up -d
#
# ── Production Docker Demo (self_hosted) ─────────────────────────────────────
# Khi chạy qua Docker (`docker compose up --build -d`), service ai_backend mặc định:
#   LLM_BACKEND=self_hosted
#   MODEL_BASE_URL=http://192.168.1.198:18083/v1
#   MODEL_NAME=bonsai-27b
#   MODEL_ENDPOINT=http://192.168.1.198:18083/v1/chat/completions
#
# Các biến BẮT BUỘC cần điền cho Live Demo / Production:
#   1. MODEL_API_KEY: API key của gateway LLM self_hosted (nếu gateway yêu cầu)
#   2. DB_HOST, DB_PORT, DB_USER, DB_PASSWORD: Thông tin kết nối Postgres VMS (read-only)
#   3. DB_NAME_ITS, DB_NAME_FENCE, DB_NAME_FACE, DB_NAME_FIRE, DB_NAME_ANOMALY
#   4. DB_ORGANIZATION_ID (mặc định 0)
#
# Để chạy OpenAI smoke test thay vì self_hosted:
#   Override trong .env: set `LLM_BACKEND=openai` và điền `LLM_API_KEY` hoặc `OPENAI_API_KEYS`.
# ─────────────────────────────────────────────────────────────────────────────

# ── API (tùy chọn) ───────────────────────────────────────────────────────────
# API_ACCESS_KEY: nếu set, mọi /api/* (trừ /api/health, /api/llm/ping) cần header X-API-Key
# Frontend: localStorage agent_api_access_key
# API_ACCESS_KEY=
# CORS_ALLOW_ORIGINS=*          # hoặc http://localhost:8080,http://127.0.0.1:8080
# CACHE_MAX_ENTRIES=500
# GATEWAY_CATALOG_TTL_S=300
# MEMORY_FALLBACK_MAX_PER_USER=200

# ── LLM ──────────────────────────────────────────────────────────────────────
# LLM_BACKEND=openai|self_hosted
# - Production Docker: mặc định self_hosted (qua compose defaults)
# - OpenAI smoke test: override LLM_BACKEND=openai bên dưới
LLM_BACKEND=self_hosted
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_S=60
# OPENAI_API_KEYS: chuỗi key cách nhau dấu phẩy để xoay vòng (comma rotation; copy từ llm-engineer-demo/.env, do not commit secrets)
OPENAI_API_KEYS=

# self_hosted: gateway 192.168.1.198:18083
MODEL_BASE_URL=http://192.168.1.198:18083/v1
MODEL_NAME=bonsai-27b
MODEL_API_KEY=your_gateway_api_key
MODEL_ENDPOINT=http://192.168.1.198:18083/v1/chat/completions

# Demo self_hosted (có thể bỏ comment hoặc để Docker compose tự default):
# LLM_BACKEND=self_hosted

# ── Postgres AGENT (memory, sessions, LangGraph) — tách VMS ─────────────────
# Docker: compose tự set AGENT_DB_HOST=agent_postgres. DBeaver trên máy host:
AGENT_DB_HOST=localhost
AGENT_DB_PORT=5433
AGENT_DB_USER=atin
AGENT_DB_PASSWORD="Atin@123#"
DB_NAME_AGENT=kcn_agent

# ── Postgres VMS (READ-ONLY, Text-to-SQL) ───────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_USER=agent_readonly
DB_PASSWORD=
DB_NAME_ITS=its
DB_NAME_FENCE=virtual_fence
DB_NAME_FACE=smart_face
DB_NAME_FIRE=firesmoke
DB_NAME_ANOMALY=anomaly
DB_ORGANIZATION_ID=0
DB_TIMEZONE=Asia/Ho_Chi_Minh
DB_QUERY_TIMEOUT_S=5.0

# ── Guardrails ───────────────────────────────────────────────────────────────
GUARDRAILS_MIN_ANSWER_LEN=5
GUARDRAILS_MAX_ANSWER_LEN=2000

# ── Langfuse — cd langfuse && docker compose up -d | admin@agent-atin.local / Atin@123# ─
MONITORING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-0c271516-d371-4a03-9ea6-0a9c22f131c2
LANGFUSE_SECRET_KEY=sk-lf-cda213a6-b0a0-4e61-9df5-ca38c0d280c3
LANGFUSE_HOST=http://localhost:3001

# ── MinIO charts (bucket chatbot-images, prefix chatbot/, TTL 10d via lifecycle) ─
MINIO_ENDPOINT=http://192.168.1.198:9200
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=chatbot-images
MINIO_CHART_PREFIX=chatbot
MINIO_PUBLIC_BASE_URL=http://192.168.1.198:9200
CHART_OBJECT_TTL_DAYS=10

# ── Memory & Context Engineering (v9) ───────────────────────────────────
# MEMORY_ENABLED=false → tắt toàn bộ cả 3 lớp memory
MEMORY_ENABLED=true
# LangGraph checkpointer (thread_id=session_id, lưu bền vững messages giữa các lượt)
MEMORY_SHORT_TERM_ENABLED=true
# Long-Term memory: Lưu trữ và truy vấn facts người dùng phân tách theo user_id
MEMORY_LONG_TERM_ENABLED=true
# Long-term facts → Qdrant (bắt buộc khi MEMORY_LONG_TERM_ENABLED=true)
# uvicorn trên host: localhost. Docker backend: compose set http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kcn_agent_memories
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# TTL Response Cache: Thời gian sống (giây) của cache phản hồi tức thì (< 5ms)
MEMORY_TTL_SECONDS=300
# Sliding Window: Số lượng tin nhắn tối đa bảo lưu trong cửa sổ hội thoại gần nhất
MEMORY_MAX_MESSAGES=20
# Ngưỡng nén chủ động: Kích hoạt tóm tắt ngữ cảnh khi vượt 40% window (nguyên tắc 40-60%)
MEMORY_COMPACT_THRESHOLD=0.40
MEMORY_CONTEXT_WINDOW_TOKENS=4000
# TTL response cache alias tương thích ngược
CACHE_ENABLED=true

# Rewrite decompose (gom trong rewrite — câu ngắn hơn ngưỡng không gọi LLM)
AGENT_DECOMPOSE_MIN_CHARS=48
AGENT_MAX_SUB_QUESTIONS=4

# ── v7 (text-to-SQL + docs YAML) ─────────────────────────────────────────────
DOCS_ROOT=resource/docs/vms_yaml
# SQL_REPAIR_MAX: số lần replan khi validate/execute lỗi (mặc định 2).
SQL_REPAIR_MAX=2
SQL_GENERATE_MAX_TOKENS=384
SQL_RESPOND_MAX_TOKENS=1024

# ── Docker Compose ports ─────────────────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
