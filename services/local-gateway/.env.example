# Local gateway env example — copy to .env
HOST=0.0.0.0
PORT=18110

# local = SQLite users, no Docker. keycloak = requires deploy/local-auth compose.
AUTH_BACKEND=local

KEYCLOAK_URL=http://127.0.0.1:18180
KEYCLOAK_REALM=creanova
KEYCLOAK_CLIENT_ID=creanova-local
KEYCLOAK_CLIENT_SECRET=creanova-local-secret

SESSION_SECRET=change-me-creanova-local-session-secret
SESSION_COOKIE_NAME=creanova_local_session
COOKIE_SECURE=false

AGENT_SERVER_URL=http://127.0.0.1:18000
AGENT_SERVER_API_KEY=

DATABASE_URL=sqlite:////tmp/creanova-local-gateway.db
# Or Postgres (host port 54288):
# DATABASE_URL=postgresql+psycopg://creanova:creanova_dev_change_me@127.0.0.1:54288/creanova

# Fernet key for SSH credential encryption (optional; derived from SESSION_SECRET if empty)
INFRA_ENCRYPTION_KEY=

CREDIT_COST_PER_RUN=1
CREDIT_COST_PER_CONVERSATION=1

CORS_ORIGINS=http://127.0.0.1:18010,http://localhost:18010,http://127.0.0.1:3001,http://localhost:3001,http://192.168.1.191:18010,http://127.0.0.1:18090,http://localhost:18090,http://192.168.1.191:18090

# Beszel hub (compose network or LAN). Used to validate X-Beszel-Token on pin APIs.
BESZEL_HUB_URL=http://127.0.0.1:18090
BESZEL_USER_EMAIL=admin@creanova.local
BESZEL_USER_PASSWORD=admin123
