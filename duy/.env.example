# LLM local — Qwen 8B
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3-16k-nothink
LLM_API_KEY=ollama

# Remote OpenAI-compatible (vd. máy 192.168.1.198)
LLM_REMOTE_BASE_URL=http://192.168.1.198:8080/v1
LLM_REMOTE_MODEL=qwen3:4b-q4_K_M
LLM_REMOTE_API_KEY=
LLM_REMOTE_LABEL=Remote · qwen3:4b (192.168.1.198)
LLM_DEFAULT_PROFILE=remote-4b

# Postgres — 192.168.1.200:18644, user read-only vinhdq
# Không set DB_NAME: mỗi câu hỏi chọn database riêng.
DB_HOST=192.168.1.200
DB_PORT=18644
DB_USER=vinhdq
DB_PASSWORD=

# Safety
QUERY_TIMEOUT_SECONDS=10
CONNECT_TIMEOUT_SECONDS=10
MAX_ROWS=200
MAX_RESULT_BYTES=1048576
SQL_REPAIR_MAX=2

# Web search — SearXNG tự host (infra/searxng)
SEARXNG_URL=http://127.0.0.1:8889
SEARXNG_LANGUAGE=vi-VN
SEARXNG_TIMEOUT_SECONDS=12
SEARXNG_MAX_RESULTS=5
