# Creanova Agent Server target
# These defaults assume you are manually pointing the frontend at a backend on
# 127.0.0.1:8000. The recommended local workflow is `npm run dev`, which starts
# an isolated local backend for this checkout. Use `npm run dev:frontend` only
# when you intentionally want to point at a separately managed backend.
VITE_BACKEND_HOST="127.0.0.1:8000" # Host:port used by the Vite dev proxy
VITE_BACKEND_BASE_URL="http://127.0.0.1:8000" # Base URL used by browser-side direct requests
# To drive a containerized ACP agent-server, point this at the published port,
# e.g. VITE_BACKEND_BASE_URL="http://localhost:8010" — see examples/acp-docker/
# and docs/ACP_AGENTS.md → "Running ACP agents in a Docker container".
# VITE_SESSION_API_KEY="" # Set to the same value as backend SESSION_API_KEY or OH_SESSION_API_KEYS_0 when auth is enabled
# VITE_WORKING_DIR="/workspace/project/agent-canvas" # Base dir for per-conversation working_dirs. Each conversation's working_dir is <VITE_WORKING_DIR>/<id_hex>. Defaults to <OH_CANVAS_SAFE_STATE_DIR>/workspaces, which is the sibling of the agent server's <state_dir>/conversations/ persistence dir — both share the same <id_hex> per conversation.
# VITE_ENABLE_BROWSER_TOOLS="true" # Set to false to omit BrowserToolSet from new conversations

# Frontend dev server
VITE_FRONTEND_PORT="3001" # Port to run the frontend application
VITE_USE_TLS="false" # Use HTTPS/WSS for proxied backend connections
VITE_INSECURE_SKIP_VERIFY="false" # Skip TLS certificate verification for proxied backend requests
# VITE_BASE_PATH="/canvas" # Build/serve the SPA under a subpath. Leave unset for root-local development.

# Public PostHog client key compiled into source builds. Precompiled library
# consumers can instead pass apiKey/apiHost/uiHost to AgentServerUIProviders.
# VITE_POSTHOG_API_KEY="phc_..."
# VITE_DO_NOT_TRACK="1" # Disable all telemetry, including anonymous install counts

# Mocking / test helpers
VITE_MOCK_API="false" # Enable/disable API mocking with MSW

# Local Keycloak multi-user auth (optional). When enabled, canvas requires /login.
# OH_LOCAL_AUTH=1
# VITE_LOCAL_AUTH_ENABLED=true
# OH_DATA_BACKEND=postgres
# LOCAL_GATEWAY_DATABASE_URL=postgresql+psycopg://creanova:PASSWORD@127.0.0.1:54288/creanova

# Beszel host/container monitoring (bundled in `docker compose up`)
# Full new-machine steps: see setup.md (images are local-only — must build first).
# UI: http://127.0.0.1:18090  login admin / admin123 (email admin@creanova.local also works)
# Keycloak OIDC is off by default. Set BESZEL_OIDC_ENABLED=true only when
# deploy/local-auth Keycloak is up (client `beszel`).
# LOCAL_ADMIN_PASSWORD=  # optional; Agents + Admin (default admin / admin123)
# Pin buttons on Containers table write to local-gateway for agent search.
# BESZEL_PORT=18090
# BESZEL_APP_URL=http://127.0.0.1:18090
# BESZEL_USER_EMAIL=admin@creanova.local
# BESZEL_USER_PASSWORD=admin123
# BESZEL_USER_USERNAME=admin
# BESZEL_OIDC_ENABLED=false
# KEYCLOAK_PUBLIC_URL=http://192.168.1.191:18180
# BESZEL_OIDC_CLIENT_ID=beszel
# BESZEL_OIDC_CLIENT_SECRET=beszel-local-secret
# Systems are auto-synced from local-gateway InfraServer DB — no manual config needed.
# INFRA_AGENT_TOKEN=  # optional; auto-generated & shared with gateway for agent SSH harness
# ClickHouse VMS analytics (local-gateway tools; copy CH_VMS_PASSWORD from deploy/clickhouse/.env)
# CH_URL=http://creanova-clickhouse:8123
# CH_USER=vms_ro
# CH_PASSWORD=
# CH_DATABASE=vms
#
# Alert email: default SMTP is local Mailpit (caught mail UI: http://127.0.0.1:18025).
# Bootstrap enables SMTP automatically — you do not need the PocketBase Mail UI.
# MAILPIT_UI_PORT=18025
# BESZEL_SMTP_ENABLED=true
# BESZEL_SMTP_HOST=mailpit
# BESZEL_SMTP_PORT=1025
# BESZEL_SMTP_USER=
# BESZEL_SMTP_PASSWORD=
# BESZEL_SMTP_TLS=false
# BESZEL_SMTP_SENDER_NAME=Creanova Alerts
# BESZEL_SMTP_SENDER_ADDRESS=alerts@creanova.local
# For real Gmail/SMTP2GO: set BESZEL_SMTP_HOST/PORT/USER/PASSWORD/TLS and restart bootstrap.

# --- Standard Creanova LiteLLM (OpenAI-compatible) ---
# On a new machine: copy this file to `.env`, set CREANOVA_LLM_API_KEY, run `npm run dev`.
# Model + Base URL are seeded into agent-server automatically; the UI pre-fills the same values.
VITE_CREANOVA_LLM_MODEL="openai/nemotron-3-nano:4b"
VITE_CREANOVA_LLM_BASE_URL="https://realtor-authentication-collecting-areas.trycloudflare.com/v1"
CREANOVA_LLM_MODEL="openai/nemotron-3-nano:4b"
CREANOVA_LLM_BASE_URL="https://realtor-authentication-collecting-areas.trycloudflare.com/v1"
# CREANOVA_LLM_API_KEY="sk-..." # User Virtual Key from your LiteLLM — required for chat
# CREANOVA_LLM_SEED="0" # set to skip auto-seed on npm run dev

# `npm run dev` (scripts/dev-safe.mjs) — isolated local backend via uvx
# OH_CANVAS_SAFE_BACKEND_PORT="18000" # Port the spawned agent-server listens on
# OH_CANVAS_SAFE_VSCODE_PORT="18001" # Port forwarded to the embedded VS Code (defaults to backend port + 1)
# OH_CANVAS_SAFE_STATE_DIR="$HOME/.Creanova/agent-canvas" # Where conversations and bash events are stored (tmux sockets live under /tmp)

# Agent server version selection (uvx) — listed in order of precedence (highest first)
# OH_AGENT_SERVER_LOCAL_PATH="" # Absolute path to a local software-agent-sdk checkout. Runs the local checkout via uvx with editable Creanova-sdk/tools/workspace installs so source edits are picked up on restart. Highest precedence.
# OH_AGENT_SERVER_GIT_REF="" # Git commit SHA or branch name (e.g., "main", "abc1234"). Takes precedence over version.
# OH_AGENT_SERVER_VERSION="" # Specific PyPI version (e.g., "1.18.0"). Uses latest release if unset.
